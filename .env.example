# Saleads - Entorno de pruebas
BASE_URL=https://keycloak.saleads.ai
KEYCLOAK_REALM=sale-ads

# Opcional: URL completa de login (con code_challenge si la app la usa)
# AUTH_URL=https://keycloak.saleads.ai/realms/sale-ads/protocol/openid-connect/auth?response_type=code&client_id=front&redirect_uri=https%3A%2F%2Fsaleads.ai%2Fapi%2Fauth%2Fcallback%2Fkeycloak&scope=openid+email+profile+offline_access&code_challenge=...&code_challenge_method=S256

# Credenciales de prueba (no subir credenciales reales)
TEST_USER=
TEST_PASSWORD=

# HEADLESS=false para ver el navegador
# SLOW_MO=80 por defecto cuando HEADLESS=false (ms entre acciones); 0 en headless
# PAUSE_AFTER_PAGE_LOAD_MS=6000 pausa al abrir la página (ms), por defecto 6 s
# PAUSE_AFTER_SECONDS=8 pausa al final de cada escenario (ver resultado), por defecto 8 s
# PAUSE_AFTER_LANGUAGE_MS=12000 pausa tras elegir idioma para ver el cambio (ms), por defecto 12 s
# USERNAME_TIMEOUT_MS=30000 tiempo de espera para que aparezca el campo usuario (ms)
# STEP_TIMEOUT_MS=60000 tiempo máximo por paso de Cucumber (ms), por defecto 60 s

# ---------------------------------------------------------------------------
# CI/CD - Envío de reporte por email (GitHub Actions: usar Secrets)
# Para Gmail: verificación en 2 pasos + "Contraseña de aplicación"
# ---------------------------------------------------------------------------
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
